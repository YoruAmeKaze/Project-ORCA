# Qwen 视觉 API（推荐）
QWEN_API_KEY=sk-your-qwen-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VL_MODEL=qwen3.7-plus

# DeepSeek API（意图分析 + 规划）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# 飞书机器人配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret

# 高德 API Key（IP定位，必填）
AMAP_API_KEY=your-amap-key

# 瑞幸咖啡 MCP（可选）
LUCKIN_MCP_TOKEN=your-luckin-mcp-token
LUCKIN_MCP_URL=https://gwmcp.lkcoffee.com/order/user/mcp

# 服务配置
HOST=0.0.0.0
PORT=8000

# 日志级别
LOG_LEVEL=INFO

# ---- Cordis 版（app-cordis，与 Python 版共用上方 DEEPSEEK_*/QWEN_*/FEISHU_* 键）----
# 飞书通道端口（默认 8100，避开 Python 版 8000）
# CORDIS_PORT=8100
# 本地调试：1 = AI 回复只写日志，不真正调用飞书发送接口
# ORCA_DRY_RUN=1

# 信息获取框架（InfoAgent）：档案室 JSONL 目录（默认 app-cordis/data/records）
# INFO_RECORDS_DIR=./data/records
# 飞书图片落盘目录（food-image 用，默认 app-cordis/data/images）
# IMAGES_DIR=./data/images
# 外部 App Push 通道端口（默认 8101）
# INFO_RECEIVER_PORT=8101
# 外部 Push 通道鉴权：JSON 对象 {"<Bearer token>": ["<namespace>", ...]}，每 App 独立 token + namespace 白名单；留空 = 通道不启动
# INFO_RECEIVER_TOKENS={"food-app-token-1":["food-agent"]}
