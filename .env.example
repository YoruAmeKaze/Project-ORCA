# ---- Project Orca 配置（app-cordis 单主线）----
# app-cordis 默认读取本文件（根 .env），app-cordis/.env 可覆盖。
# 复制为 .env 后填写真实值。ORCA_*_ENABLED 类开关必须严格写 1（true/yes/on 不生效）。

# ---- 主 LLM（DeepSeek）----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 飞书机器人 ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret

# ---- 视觉识别（food-agent 内部用）----
# 后端切换：ollama（本地，免 apiKey）| dashscope（云端，默认）
ORCA_VISION_BACKEND=dashscope
# 云端（dashscope）
QWEN_API_KEY=sk-your-qwen-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VL_MODEL=qwen3.7-plus
# 本地（Ollama，需支持图片输入，如 qwen3-vl:4b）
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VL_MODEL=qwen3-vl:4b

# ---- 服务 ----
# CORDIS_HOST=0.0.0.0
# CORDIS_PORT=8100
# 本地调试：1 = AI 回复只写日志，不真正调用飞书发送接口
# ORCA_DRY_RUN=1
# 每会话保留轮数（内存会话）
# ORCA_HISTORY_TURNS=10

# ---- 信息获取框架（InfoAgent）----
# 档案室 JSONL 目录（默认 app-cordis/data/records）
# INFO_RECORDS_DIR=./data/records
# 飞书图片落盘目录（food-image 用，默认 app-cordis/data/images）
# IMAGES_DIR=./data/images
# 外部 App Push 通道端口（默认 8101）
# INFO_RECEIVER_PORT=8101
# 外部 Push 通道鉴权：JSON {"<Bearer token>": ["<namespace>", ...]}；留空 = 通道不启动。
# 两个端点共用：POST /info/records（结构化上报）+ POST /info/images（直连图片上传，token 白名单须含 food-agent）
# INFO_RECEIVER_TOKENS={"food-app-token-1":["food-agent"]}
# 会话绑定路由（D-AGENT-15）：{"<chat_id>": "<agent>"}；未绑定会话 → 默认 Orca 主管线
# ORCA_CHAT_BINDINGS={"oc_xxx_food_group":"food-agent"}

# ---- Persistent Context Runtime（Phase 0+1 ~ Phase 3）----
# 总开关：1 = 启用 Orca Runtime（EventBus + WorldState + Attention）；必须严格写 1
# ORCA_RUNTIME_ENABLED=0
# EventBus 滑动窗口大小（默认 200）
# ORCA_RUNTIME_WINDOW=200
# WorldState 开关（默认启用；=0 关闭）
# ORCA_WORLD_STATE_ENABLED=1
# WorldState time tick 间隔 ms（默认 60000；Phase 2.C away 自动推导用）
# ORCA_WORLD_STATE_REFRESH_MS=60000
# PC/Calendar/Phone mock adapters（Phase 2.D，全部默认 disabled；=1 启用）
# ORCA_PC_ENABLED=0
# ORCA_PC_REFRESH_MS=60000
# ORCA_CALENDAR_ENABLED=0
# ORCA_CALENDAR_REFRESH_MS=120000
# ORCA_PHONE_ENABLED=0
# ORCA_PHONE_REFRESH_MS=300000
# Attention Engine（Phase 3，默认启用；纯评估不执行 action，安全默认；=0 关闭）
# ORCA_ATTENTION_ENABLED=1
