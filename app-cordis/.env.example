# Project Orca — Cordis 版（Phase 1）配置说明
# 默认从仓库根 .env 读取（与 Python 版共用 DEEPSEEK_*/FEISHU_* 等键）。
# 如需覆盖，复制本文件为 app-cordis/.env（app-cordis/.env 优先于仓库根 .env）。

# 服务监听（默认 0.0.0.0:8100，避开 Python 版的 8000）
# CORDIS_HOST=0.0.0.0
# CORDIS_PORT=8100

# 本地调试开关：1 = AI 回复只写日志，不真正调用飞书发送接口
# ORCA_DRY_RUN=1

# 每会话保留的对话轮数（内存会话，Phase 2 再引入持久化）
# ORCA_HISTORY_TURNS=10

# 飞书 API 地址（一般无需改）
# FEISHU_API_URL=https://open.feishu.cn
