# Project Orca — Cordis 版（Phase 2：信息获取框架）配置说明
# 默认从仓库根 .env 读取（与 Python 版共用 DEEPSEEK_*/FEISHU_*/QWEN_* 等键）。
# 如需覆盖，复制本文件为 app-cordis/.env（app-cordis/.env 优先于仓库根 .env）。

# 服务监听（默认 0.0.0.0:8100，避开 Python 版的 8000）
# CORDIS_HOST=0.0.0.0
# CORDIS_PORT=8100

# 本地调试开关：1 = AI 回复只写日志，不真正调用飞书发送接口
# ORCA_DRY_RUN=1

# 每会话保留的对话轮数（内存会话，Phase 2 再引入持久化）
# ORCA_HISTORY_TURNS=10

# 飞书 API 地址（一般无需改）
# FEISHU_API_URL=https://open.feishu.cn

# ---- 信息获取框架（InfoAgent）----

# 档案室目录（默认 app-cordis/data/records，每 namespace 一个 JSONL）
# INFO_RECORDS_DIR=./data/records

# 飞书图片落盘目录（food-image 用，默认 app-cordis/data/images）
# IMAGES_DIR=./data/images

# 外部 App Push 通道端口（默认 8101；不冲突即可）
# INFO_RECEIVER_PORT=8101

# 外部 Push 通道鉴权：JSON 对象 {"<Bearer token>": ["<namespace>", ...]}
# 每 App 独立 token + namespace 白名单（D-AGENT-12）。留空 = 通道不启动。
# 两个端点共用此鉴权：
#   POST /info/records — 结构化记录上报
#   POST /info/images  — 直连图片上传（跳过飞书，快捷指令 Base64 → food 管线识别 → 同步返回结果；token 白名单须含 food-agent）
# INFO_RECEIVER_TOKENS={"food-app-token-1":["food-agent"]}

# 会话绑定路由（D-AGENT-15 工位分配）：JSON 对象 {"<chat_id>": "<agent>"}
# 一个 bot 多个群 = 多个工位：食物群 → food-agent，主聊天不配 → 默认 Orca 主管线。
# 图片事件按 chat_id 查表只派发给绑定 agent（不广播）；未绑定会话的图片 → 默认主管线（当前忽略）。
# 留空 = 全部走默认主管线。
# ORCA_CHAT_BINDINGS={"oc_xxx_food_group":"food-agent"}

# 视觉识别（food-agent 内部用 Qwen，与 Python 版共用键）
# QWEN_API_KEY=sk-your-qwen-key
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_VL_MODEL=qwen3.7-plus
