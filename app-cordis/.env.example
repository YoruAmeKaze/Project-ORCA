# Project Orca unified environment
# Copy ../.env.example to the repository root as ../.env.
# app-cordis loads the root file first, then this file as an optional override.
# Keep only intentional Cordis-specific overrides here, for example:
# CORDIS_PORT=8100
# ORCA_LLM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_LM_MODEL=qwen3:8b
